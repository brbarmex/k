# ---- Volumes e dados locais do DR (só existem na máquina de quem roda) ----
# Os volumes do compose são volumes nomeados do Docker e não ficam na pasta, mas uma
# execução local fora do Docker (ou um bind mount) grava o WAL e o log de replicação aqui.
/data/
/volumes/
/var/
/c[0-9]*/
*.wal
*.seg
**/replog/progress
**/raft/wal/
.localstack/
volume/

# ---- Binários Go ----
/datareplication
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
__debug_bin*

# ---- Cobertura e perfis ----
coverage.*
*.coverprofile
*.prof
*.pprof

# ---- Dependências vendorizadas e workspaces ----
/vendor/
go.work
go.work.sum

# ---- Task ----
.task/

# ---- Ambiente local e segredos (nenhuma credencial real no repositório, SG-13) ----
.env
.env.*
*.local.yml
docker-compose.override.yml

# ---- Editores e sistema ----
.idea/
.vscode/
*.swp
*~
.DS_Store
